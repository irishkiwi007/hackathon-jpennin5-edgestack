# Borrowed engine: only the submitted strategy's lineage and the benchmark are
# public. The operator's own strategies (and candidates derived from them) are
# live money elsewhere and stay out of this repo (engine/BORROWED.md).
engine/strategies/*
!engine/strategies/edgestack*.py
!engine/strategies/bench_spy_hold.py
# agent-authored families (publishable by the operator's rule); new ones carry the edgestack_ prefix
!engine/strategies/regimebasket*.py
!engine/strategies/regimeduo*.py
!engine/strategies/voltgt*.py
engine/data/*
!engine/data/SPY.csv
!engine/data/SPYON.csv
!engine/data/QQQ.csv
!engine/data/SOXX.csv
!engine/data/XLV.csv
!engine/data/XLP.csv
!engine/data/HYG.csv
!engine/data/FDN.csv
# histories the agent-authored families reference (GLD, IEF, TLT)
!engine/data/GLD.csv
!engine/data/IEF.csv
!engine/data/TLT.csv
journal/reproductions/
