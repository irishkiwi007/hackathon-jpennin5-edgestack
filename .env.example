# Copy to .env and fill in. .env is gitignored — keep it that way.
# Paper keys: https://app.alpaca.markets/paper/dashboard/overview  (Home -> API Keys)

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# true = paper (simulated money, real market data). false = REAL MONEY.
ALPACA_PAPER_TRADE=true

# Optional. Comma-separated; omit for all 11 toolsets (~70 tools).
# Valid: account, trading, watchlists, assets, stock-data, crypto-data,
#        options-data, corporate-actions, news, fixed-income-data, locates
# For the hackathon a narrower set keeps the model's tool list focused:
# ALPACA_TOOLSETS=account,trading,assets,options-data,stock-data
